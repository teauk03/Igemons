POSTGRES_DB=igemons
POSTGRES_USER=igemons
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/igemons
DATABASE_USERNAME=igemons
DATABASE_PASSWORD=change-me-for-local-development
FRONTEND_URL=http://localhost:3000

# 카카오 개발자 콘솔 (https://developers.kakao.com)
# 애플리케이션 > 앱 키 > REST API 키
KAKAO_CLIENT_ID=your_kakao_rest_api_key
# 보안 > Client Secret (선택)
KAKAO_CLIENT_SECRET=

# JWT 시크릿 (최소 32자 이상의 랜덤 문자열 권장)
JWT_SECRET=change-me-to-a-long-random-secret-key-at-least-32-chars
JWT_EXPIRATION_MS=604800000
